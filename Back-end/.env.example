# Cadena de conexión a PostgreSQL (Neon en producción; usa la conexión directa con ?sslmode=require)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE"
# Puerto local (Render lo asigna solo en producción)
PORT=4000
# Opcional: dominios del frontend permitidos por CORS, separados por coma.
# Si se deja vacío se permite cualquier origen.
CORS_ORIGIN=

# ── Correo (Tarjeta 4) ── Si SMTP_HOST queda vacío los correos se simulan en consola.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rancho Puerta Pesada <avisos@tu-dominio.com>"
# Destinatarios de alertas (coma). Vacío = correos de los administradores.
ALERTAS_CORREO=

# ── Programador de alertas ──
PROGRAMADOR_ACTIVO=true
PROGRAMADOR_MINUTOS=15
HORA_RESUMEN_STOCK=7
