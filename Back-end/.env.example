# Cadena de conexión a PostgreSQL (Neon en producción; usa la conexión directa con ?sslmode=require)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE"
# Puerto local (Render lo asigna solo en producción)
PORT=4000
# Opcional: dominios del frontend permitidos por CORS, separados por coma.
# Si se deja vacío se permite cualquier origen.
CORS_ORIGIN=
