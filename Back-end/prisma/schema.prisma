generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConfiguracionRancho {
  idConfiguracion Int    @id @default(autoincrement())
  nombreRancho    String @db.VarChar(100)
  logoUrl         String @db.VarChar(255) // Ruta local ej: "/assets/rancho-logo.png"
  moneda          String @default("MXN") @db.VarChar(5)
  unidadPeso      String @default("kg") @db.VarChar(10)

  @@map("configuracion_rancho")
}

model PuestoEmpleado {
  idPuesto   Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(50)
  activo     Boolean  @default(true)

  empleados  Empleado[]

  @@map("puestos_empleado")
}

model Empleado {
  idEmpleado             Int      @id @default(autoincrement())
  nombreCompleto         String   @db.VarChar(150)
  correo                 String   @unique @db.VarChar(100)
  contrasenaHash         String   @db.VarChar(255)
  rol                    String   @db.VarChar(20) // 'Empleado', 'Administrador'
  
  idPuesto               Int?
  puestoRelacion         PuestoEmpleado? @relation(fields: [idPuesto], references: [idPuesto], onDelete: SetNull)
  
  telefono               String?  @db.VarChar(15)

  eventos                Evento[]
  controlesSanitarios    ControlSanitario[]
  movimientosInventario  MovimientoInventario[]
  reportes               Reporte[]
  movimientosFinancieros MovimientoFinanciero[]

  // ── Expediente de RR.HH. (Tarjeta 1) ──
  estatus                String    @default("Activo") @db.VarChar(20) // 'Activo', 'Inactivo', 'Vacaciones'
  fechaContratacion      DateTime? @db.Date
  direccion              String?   @db.VarChar(200)
  contactoEmergencia     String?   @db.VarChar(150)
  notas                  String?   @db.Text
  asignacionesCorral     AsignacionCorral[]
  transacciones          Transaccion[]

  @@map("empleados")
}

model TipoAnimal {
  idTipoAnimal Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(30)
  activo       Boolean @default(true) // Control activo/inactivo

  animales     Animal[]
  razas        Raza[]
  usos         UsoAnimal[]
  etapas       EtapaDesarrollo[]

  @@map("tipo_animal")
}

model Raza {
  idRaza       Int        @id @default(autoincrement())
  idTipoAnimal Int
  nombre       String     @db.VarChar(50)
  activo       Boolean    @default(true) // Control activo/inactivo

  tipoAnimal   TipoAnimal @relation(fields: [idTipoAnimal], references: [idTipoAnimal], onDelete: Cascade)
  animales     Animal[]

  @@map("razas")
}

model UsoAnimal {
  idUso        Int        @id @default(autoincrement())
  idTipoAnimal Int
  nombre       String     @db.VarChar(50) // 'Engorda', 'Leche', 'Charrería', etc.

  tipoAnimal   TipoAnimal @relation(fields: [idTipoAnimal], references: [idTipoAnimal], onDelete: Cascade)
  animales     Animal[]

  @@map("usos_animal")
}

model Corral {
  idCorral        Int    @id @default(autoincrement())
  nombre          String @db.VarChar(50)
  capacidadMaxima Int

  animales             Animal[]
  controlesSanitarios  ControlSanitario[]
  asignaciones         AsignacionCorral[]

  @@map("corrales")
}

model Animal {
  idAnimal        Int       @id @default(autoincrement())
  idCorral        Int
  idTipoAnimal    Int
  idRaza          Int
  idUso           Int?
  areteBandera    String    @db.VarChar(20) @map("arete_bandera")
  areteBoton      String?   @db.VarChar(20) @map("arete_boton")
  nombre          String?   @db.VarChar(50)
  genero          String    @db.VarChar(10) // 'Macho', 'Hembra'
  origen          String    @db.VarChar(10) // 'Nacimiento', 'Compra'
  fechaNacimiento DateTime? @db.Date
  fechaIngreso    DateTime  @db.Date
  estado          String    @db.VarChar(20) // 'Vivo', 'Vendido', 'Muerto'

  // ── Campo agregado para detalle de Mestizo ──
  detalleMestizo  String?   @db.VarChar(100) @map("detalle_mestizo")

  // ── Línea Genética (Autorreferencias por arete/ID) ──
  idPadre         Int?
  idMadre         Int?

  padre           Animal?   @relation("PadreHijos", fields: [idPadre], references: [idAnimal], onDelete: SetNull)
  hijosDelPadre   Animal[]  @relation("PadreHijos")

  madre           Animal?   @relation("MadreHijos", fields: [idMadre], references: [idAnimal], onDelete: SetNull)
  hijosDeLaMadre  Animal[]  @relation("MadreHijos")
  // ────────────────────────────────────────────────────

  corral          Corral     @relation(fields: [idCorral], references: [idCorral])
  tipoAnimal      TipoAnimal @relation(fields: [idTipoAnimal], references: [idTipoAnimal])
  raza            Raza       @relation(fields: [idRaza], references: [idRaza])
  uso             UsoAnimal? @relation(fields: [idUso], references: [idUso])

  historicos      HistoricoAnimal[]
  tratamientos    TratamientoAnimal[]
  ventasAnimales  VentaAnimal[]
  detallesTransaccion TransaccionDetalle[]

  @@map("animales")
}

model HistoricoAnimal {
  idHistorico Int      @id @default(autoincrement())
  idAnimal    Int
  fecha       DateTime @db.Date
  peso        Decimal  @db.Decimal(6, 2)
  etapa       String   @db.VarChar(20)

  animal      Animal   @relation(fields: [idAnimal], references: [idAnimal], onDelete: Cascade)

  @@map("historico_animal")
}

model Evento {
  idEvento    Int       @id @default(autoincrement())
  idEmpleado  Int
  tipo        String    @db.VarChar(30)
  fecha       DateTime  @db.Date
  hora        DateTime? @db.Time()
  descripcion String    @db.Text
  estado      String    @db.VarChar(20)

  empleado    Empleado  @relation(fields: [idEmpleado], references: [idEmpleado])

  // ── Agenda inteligente (Tarjeta 4) ──
  titulo          String?   @db.VarChar(120)
  recurrencia     String    @default("Ninguna") @db.VarChar(15) // 'Ninguna', 'Semanal', 'Mensual'
  diasSemana      String?   @db.VarChar(20)  // "6" = sábado, "1,3" = lunes y miércoles (0 = domingo)
  fechaFin        DateTime? @db.Date
  notificarCorreo Boolean   @default(false)
  correoDestino   String?   @db.VarChar(255)
  ultimoEnvio     DateTime? @db.Timestamp(6)

  @@map("eventos")
}

model ControlSanitario {
  idControl     Int       @id @default(autoincrement())
  idCorral      Int?
  tipo          String    @db.VarChar(30)
  fecha         DateTime  @db.Date
  producto      String    @db.VarChar(100)
  dosis         String?   @db.VarChar(50)   // Almacena la dosis aplicada
  responsable   Int       // Relación directa con Empleado
  ayudantes     String?   @db.VarChar(150)  // Personal de apoyo separado
  observaciones String?   @db.Text          // Observaciones generales de la campaña
  estado        String?   @db.VarChar(20)

  corral        Corral?   @relation(fields: [idCorral], references: [idCorral])
  empleado      Empleado  @relation(fields: [responsable], references: [idEmpleado])
  tratamientos  TratamientoAnimal[]

  @@map("control_sanitario")
}

model TratamientoAnimal {
  idTratamiento   Int       @id @default(autoincrement())
  idControl       Int
  idAnimal        Int
  estado          String    @db.VarChar(20) // 'Aplicado' o 'Omitido'
  fechaAplicacion DateTime? @db.Date
  observaciones   String?   @db.Text        // Nota u observación específica para este animal

  controlSanitario ControlSanitario @relation(fields: [idControl], references: [idControl], onDelete: Cascade)
  animal           Animal           @relation(fields: [idAnimal], references: [idAnimal], onDelete: Cascade)

  @@map("tratamiento_animal")
}

model Cliente {
  idClient   Int     @id @default(autoincrement()) @map("idCliente")
  nomCliente String  @db.VarChar(100)
  telefono   String? @db.VarChar(15)
  correo     String? @db.VarChar(100)

  ventas     Venta[]
  transacciones Transaccion[]

  @@map("clientes")
}

model Venta {
  idVenta   Int      @id @default(autoincrement())
  idCliente Int
  fecha     DateTime @db.Date
  total     Decimal  @db.Decimal(10, 2)
  estado    String   @db.VarChar(10) // 'Pagado', 'Pendiente'

  cliente        Cliente     @relation(fields: [idCliente], references: [idClient])
  ventasAnimales VentaAnimal[]

  @@map("ventas")
}

model VentaAnimal {
  idVentaAnimal Int      @id @default(autoincrement())
  idVenta       Int
  idAnimal      Int
  fechaVenta    DateTime @db.Date

  venta         Venta    @relation(fields: [idVenta], references: [idVenta], onDelete: Cascade)
  animal        Animal   @relation(fields: [idAnimal], references: [idAnimal])

  @@map("venta_animal")
}

model Inventario {
  idInventario   Int    @id @default(autoincrement())
  nombre         String @db.VarChar(100)
  categoria      String @db.VarChar(50)
  cantidadActual Int
  unidad         String @db.VarChar(20)
  stockMinimo    Int

  movimientos    MovimientoInventario[]

  // ── Inventario diferenciado (Tarjeta 2) ──
  tipo           String  @default("Consumible") @db.VarChar(15) // 'Herramienta', 'Consumible'
  stockCritico   Int     @default(0)  // Umbral rojo; stockMinimo es el umbral amarillo
  ubicacion      String? @db.VarChar(100)
  descripcion    String? @db.Text
  activo         Boolean @default(true)
  detallesTransaccion TransaccionDetalle[]

  @@map("inventario")
}

model MovimientoInventario {
  idMovimiento   Int      @id @default(autoincrement())
  idInventario   Int
  idEmpleado     Int
  tipoMovimiento String   @db.VarChar(10) // 'Entrada', 'Salida'
  cantidad       Int
  fecha          DateTime @db.Date

  inventario     Inventario @relation(fields: [idInventario], references: [idInventario])

  motivo          String?   @db.VarChar(200)
  estadoPrestamo  String?   @db.VarChar(15) // 'Prestado', 'Devuelto' (solo herramientas)
  fechaDevolucion DateTime? @db.Date
  empleado       Empleado   @relation(fields: [idEmpleado], references: [idEmpleado])

  @@map("movimiento_inventario")
}

model Equipo {
  idEquipo  Int    @id @default(autoincrement())
  nombre    String @db.VarChar(100)
  categoria String @db.VarChar(50)
  estado    String @db.VarChar(20)

  @@map("equipos")
}

model Reporte {
  idReporte            Int      @id @default(autoincrement())
  idEmpleado           Int
  categoriaReporte     String   @db.VarChar(15) // 'Inventario','Equipo','Animal','General'
  idInventarioAfectado Int?
  idEquipoAfectado     Int?
  idAnimalAfectado     Int?
  titulo               String   @db.VarChar(100)
  descripcion          String   @db.Text
  fecha                DateTime @default(now()) @db.Timestamp(6)

  // ── Incidencias (Tarjeta 5) ──
  tipoIncidencia       String    @default("Aviso general") @db.VarChar(40) // 'Animal lesionado', 'Daño en vehículo/maquinaria', 'Aviso general'
  prioridad            String    @default("Media") @db.VarChar(10)
  estado               String    @default("Pendiente") @db.VarChar(15) // 'Pendiente', 'En revisión', 'Atendido', 'Descartado'
  fotoUrl              String?   @db.Text // Imagen en base64 (data URL)
  respuesta            String?   @db.Text
  atendidoPor          String?   @db.VarChar(150)
  fechaAtencion        DateTime? @db.Timestamp(6)

  empleado             Empleado @relation(fields: [idEmpleado], references: [idEmpleado])

  @@map("reportes")
}

model MovimientoFinanciero {
  idMovimiento Int      @id @default(autoincrement())
  idEmpleado   Int
  tipo         String   @db.VarChar(10) // 'Ingreso', 'Egreso'
  categoria    String   @db.VarChar(50)
  monto        Decimal  @db.Decimal(10, 2)
  fecha        DateTime @db.Date
  descripcion  String   @db.Text

  empleado     Empleado @relation(fields: [idEmpleado], references: [idEmpleado])

  @@map("movimiento_financiero")
}

// ════════════════════════ MODELOS NUEVOS ════════════════════════

// Tarjeta 1 — Corrales/responsabilidades asignadas a un empleado
model AsignacionCorral {
  idAsignacion    Int      @id @default(autoincrement())
  idEmpleado      Int
  idCorral        Int
  responsabilidad String?  @db.VarChar(100)
  fechaAsignacion DateTime @default(now()) @db.Date

  empleado        Empleado @relation(fields: [idEmpleado], references: [idEmpleado], onDelete: Cascade)
  corral          Corral   @relation(fields: [idCorral], references: [idCorral], onDelete: Cascade)

  @@unique([idEmpleado, idCorral])
  @@map("asignacion_corral")
}

// Tarjeta 3 — Proveedores para compras
model Proveedor {
  idProveedor   Int     @id @default(autoincrement())
  nombre        String  @db.VarChar(100)
  telefono      String? @db.VarChar(15)
  correo        String? @db.VarChar(100)

  transacciones Transaccion[]

  @@map("proveedores")
}

// Tarjeta 3 — Transacción comercial (compra o venta)
model Transaccion {
  idTransaccion Int      @id @default(autoincrement())
  folio         String   @unique @db.VarChar(20)
  tipo          String   @db.VarChar(10) // 'Compra', 'Venta'
  idCliente     Int?
  idProveedor   Int?
  idEmpleado    Int?     // Quién la registró
  fecha         DateTime @db.Date
  total         Decimal  @db.Decimal(12, 2)
  estado        String   @default("Pagado") @db.VarChar(15) // 'Pagado', 'Pendiente', 'Cancelado'
  metodoPago    String?  @db.VarChar(20)
  notas         String?  @db.Text
  creadoEn      DateTime @default(now()) @db.Timestamp(6)

  cliente       Cliente?   @relation(fields: [idCliente], references: [idClient])
  proveedor     Proveedor? @relation(fields: [idProveedor], references: [idProveedor])
  empleado      Empleado?  @relation(fields: [idEmpleado], references: [idEmpleado], onDelete: SetNull)
  detalles      TransaccionDetalle[]

  @@map("transacciones")
}

model TransaccionDetalle {
  idDetalle      Int     @id @default(autoincrement())
  idTransaccion  Int
  concepto       String  @db.VarChar(15) // 'Animal', 'Insumo', 'Herramienta', 'Otro'
  descripcion    String  @db.VarChar(200)
  idAnimal       Int?
  idInventario   Int?
  cantidad       Int     @default(1)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  transaccion    Transaccion @relation(fields: [idTransaccion], references: [idTransaccion], onDelete: Cascade)
  animal         Animal?     @relation(fields: [idAnimal], references: [idAnimal], onDelete: SetNull)
  inventario     Inventario? @relation(fields: [idInventario], references: [idInventario], onDelete: SetNull)

  @@map("transaccion_detalle")
}

// Tarjeta 6 — Centro de notificaciones
model Notificacion {
  idNotificacion Int      @id @default(autoincrement())
  clave          String   @unique @db.VarChar(120) // Evita duplicar la misma alerta (ej. "stock-5-critico")
  tipo           String   @db.VarChar(20) // 'Endogamia', 'Stock', 'Evento', 'Incidencia', 'Etapa'
  severidad      String   @default("info") @db.VarChar(10) // 'info', 'aviso', 'critico'
  titulo         String   @db.VarChar(150)
  mensaje        String   @db.Text
  vista          String?  @db.VarChar(30) // Vista del front a la que lleva
  leida          Boolean  @default(false)
  eliminada      Boolean  @default(false) // Borrado lógico: no se vuelve a generar
  fecha          DateTime @default(now()) @db.Timestamp(6)

  @@map("notificaciones")
}

// Tarjeta 7 — Etapas de desarrollo configurables por tipo de animal
model EtapaDesarrollo {
  idEtapa      Int        @id @default(autoincrement())
  idTipoAnimal Int
  nombre       String     @db.VarChar(30)
  mesInicio    Int        // Edad en meses en que inicia (inclusive)
  mesFin       Int?       // Edad en meses en que termina (exclusivo). null = sin límite
  orden        Int        @default(0)
  color        String     @default("emerald") @db.VarChar(15)

  tipoAnimal   TipoAnimal @relation(fields: [idTipoAnimal], references: [idTipoAnimal], onDelete: Cascade)

  @@map("etapas_desarrollo")
}
